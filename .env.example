# Settings of the MAVR companion stack. scripts/gen-secrets.sh copies this file to .env (mode 600)
# and fills in the three secrets. Never commit .env. Plain KEY=value lines, no quotes needed.

# --- mavr-sync ---
# Shared secret (at least 32 characters, no spaces); enter the same value in Moodle as "Shared secret".
MAVR_SYNC_SECRET=
# The Moodle site(s) allowed to issue room tokens: wwwroot from config.php, comma-separated, no trailing slash.
MAVR_SYNC_ISSUERS=https://moodle.example.org
# Address and port mavr-sync listens on; keep it on loopback and let the reverse proxy forward to it.
MAVR_SYNC_LISTEN=127.0.0.1:8090
# Largest number of people in one room (2 to 100); Moodle's own limit is 50.
MAVR_SYNC_MAX_ROOM_PEERS=50
# Log level: error, warn, info or debug (no level logs names, ids, IP addresses or tokens).
MAVR_SYNC_LOG_LEVEL=info

# --- optional mavr-sync settings (defaults shown; remove the "# " to change one) ---
# Browser origins allowed to open the WebSocket (default: the origins of MAVR_SYNC_ISSUERS).
# MAVR_SYNC_ORIGINS=https://moodle.example.org
# Most rooms open at the same time.
# MAVR_SYNC_MAX_ROOMS=1000
# Most WebSocket connections at the same time.
# MAVR_SYNC_MAX_CONNECTIONS=2000
# Most connections that have not yet sent their token.
# MAVR_SYNC_MAX_PENDING=200
# How often positions are sent to each browser, per second (1 to 30).
# MAVR_SYNC_POSE_HZ=15
# Seconds a person whose connection dropped stays in the room before the others are told (0 to 60).
# MAVR_SYNC_GRACE_SECONDS=10
# Extension modules (Phase 5), comma-separated absolute paths under /app/extensions/.
# MAVR_SYNC_EXTENSIONS=

# --- LiveKit (also used by mavr-sync to remove people from voice when they leave a room) ---
# LiveKit server image tag; change it together with quadlet/mavr-livekit.container.
LIVEKIT_TAG=v1.13.9
# LiveKit API key (letters and digits); enter it in Moodle as "LiveKit API key".
LIVEKIT_API_KEY=
# LiveKit API secret (at least 32 characters); enter it in Moodle as "LiveKit API secret".
LIVEKIT_API_SECRET=
# Where mavr-sync reaches LiveKit's API on this host; leave empty to switch the voice removal off.
LIVEKIT_API_URL=http://127.0.0.1:7880
# IP address browsers use to reach this host for voice (the public address, or the LAN address for testing).
LIVEKIT_NODE_IP=
# First UDP port LiveKit uses for voice (open the range in the firewall).
LIVEKIT_UDP_START=50000
# Last UDP port LiveKit uses for voice (about four ports per person; 200 ports suit 50 people).
LIVEKIT_UDP_END=50199
