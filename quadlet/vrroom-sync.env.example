# Non-secret settings of vrroom-sync for the Quadlet install, read from
# ~/.config/vrroom-companion/vrroom-sync.env (mode 600). scripts/gen-secrets.sh --podman-secrets writes
# that file from .env; copy this example there only if you set things up by hand. The secrets
# (VRROOM_SYNC_SECRET, LIVEKIT_API_KEY, LIVEKIT_API_SECRET) come from Podman secrets, never from here.

# The Moodle site(s) allowed to issue room tokens: wwwroot from config.php, comma-separated, no trailing slash.
VRROOM_SYNC_ISSUERS=https://moodle.example.org
# Address and port vrroom-sync listens on; keep it on loopback and let the reverse proxy forward to it.
VRROOM_SYNC_LISTEN=127.0.0.1:8090
# Largest number of people in one room (2 to 100); Moodle's own limit is 50.
VRROOM_SYNC_MAX_ROOM_PEERS=50
# Log level: error, warn, info or debug.
VRROOM_SYNC_LOG_LEVEL=info
# Where vrroom-sync reaches LiveKit's API on this host; leave empty to switch the voice removal off.
LIVEKIT_API_URL=http://127.0.0.1:7880
