# Rootless Podman Quadlet unit for mavr-sync (copy to ~/.config/containers/systemd/).
#
# Needs: the image localhost/mavr-sync:0.1.0 (podman build -t localhost/mavr-sync:0.1.0 sync),
# the Podman secrets mavr_sync_secret, mavr_livekit_api_key and mavr_livekit_api_secret, and
# ~/.config/mavr-companion/mavr-sync.env (both made by scripts/gen-secrets.sh --podman-secrets).
# The health check connects to 127.0.0.1 on the port of MAVR_SYNC_LISTEN, so keep the listen
# address 127.0.0.1 or 0.0.0.0. Podman 4.6 or later.

[Unit]
Description=MAVR companion: room sync service
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/mavr-sync:0.1.0
ContainerName=mavr-sync
Network=host
EnvironmentFile=%h/.config/mavr-companion/mavr-sync.env
Secret=mavr_sync_secret,type=env,target=MAVR_SYNC_SECRET
Secret=mavr_livekit_api_key,type=env,target=LIVEKIT_API_KEY
Secret=mavr_livekit_api_secret,type=env,target=LIVEKIT_API_SECRET
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=node -e "fetch('http://127.0.0.1:'+((process.env.MAVR_SYNC_LISTEN||'127.0.0.1:8090').split(':').pop())+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s

[Service]
Restart=always

[Install]
WantedBy=default.target
